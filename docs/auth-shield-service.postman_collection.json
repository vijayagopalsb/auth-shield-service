		{
			"name": "2. Multi-Factor Authentication (MFA / TOTP)",
			"item": [
				{
					"name": "Step A: Setup MFA (Generates Secret & QR Code)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res.secret) {",
									"    pm.collectionVariables.set('mfa_secret', res.secret);",
									"}",
									"",
									"// Render QR Code in Postman Visualizer tab",
									"if (res.qrCodeDataUrl) {",
									"    pm.visualizer.set(`",
									"        <div style=\"font-family: Arial, sans-serif; text-align: center; padding: 25px; background: #fdfdfd;\">",
									"            <h2 style=\"color: #2c3e50;\">Scan QR in Google Authenticator</h2>",
									"            <img src=\"${res.qrCodeDataUrl}\" style=\"border: 3px solid #34495e; border-radius: 8px;\" />",
									"            <p style=\"margin-top: 15px; font-size: 15px;\"><strong>Secret Key:</strong> <code>${res.secret}</code></p>",
									"            <p style=\"color: #7f8c8d; font-size: 13px;\">Or tap 'Enter a setup key' in Google Authenticator</p>",
									"        </div>",
									"    `);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/auth/mfa/setup",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "mfa", "setup"]
						}
					}
				},
				{
					"name": "Step B: Confirm & Enable MFA",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Automatically compute RFC 6238 TOTP using Postman's built-in CryptoJS",
									"const base32chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';",
									"function base32tohex(base32) {",
									"    let bits = '';",
									"    let hex = '';",
									"    let clean = base32.toUpperCase().replace(/[^A-Z2-7]/g, '');",
									"    for (let i = 0; i < clean.length; i++) {",
									"        let val = base32chars.indexOf(clean.charAt(i));",
									"        bits += val.toString(2).padStart(5, '0');",
									"    }",
									"    for (let i = 0; i + 4 <= bits.length; i += 4) {",
									"        let chunk = bits.substr(i, 4);",
									"        hex = hex + parseInt(chunk, 2).toString(16);",
									"    }",
									"    return hex;",
									"}",
									"",
									"const secret = pm.collectionVariables.get('mfa_secret');",
									"if (secret) {",
									"    const epoch = Math.floor(new Date().getTime() / 1000.0);",
									"    const time = Math.floor(epoch / 30).toString(16).padStart(16, '0');",
									"    const keyWordArray = CryptoJS.enc.Hex.parse(base32tohex(secret));",
									"    const timeWordArray = CryptoJS.enc.Hex.parse(time);",
									"    const hmac = CryptoJS.HmacSHA1(timeWordArray, keyWordArray);",
									"    const hmacHex = hmac.toString(CryptoJS.enc.Hex);",
									"    const offset = parseInt(hmacHex.substring(hmacHex.length - 1), 16) * 2;",
									"    const otp = (parseInt(hmacHex.substr(offset, 8), 16) & 0x7fffffff) % 1000000;",
									"    const totpCode = otp.toString().padStart(6, '0');",
									"    pm.collectionVariables.set('totp_code', totpCode);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"code\": \"{{totp_code}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/mfa/enable",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "mfa", "enable"]
						}
					}
				},
